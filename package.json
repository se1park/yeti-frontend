{
  "name": "yeti-frontend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web && node electron/patch-dist.js",
    "desktop": "npm run web:build && electron electron/main.js",
    "desktop:dev": "set ELECTRON_START_URL=http://localhost:8081&& electron electron/main.js"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.11",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "devDependencies": {
    "electron": "^42.4.0"
  }
}
